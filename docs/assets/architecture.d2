

direction: down

# ... tiếp tục các khối và kết nối bên dưới ...
direction: down

classes: {
  rf_node: {
    style: {
      fill: "#FEF3C7"
      stroke: "#D97706"
      stroke-width: 2
      font-color: "#92400E"
      border-radius: 6
    }
  }
  cal_node: {
    style: {
      fill: "#FFE4E6"
      stroke: "#E11D48"
      stroke-width: 2
      font-color: "#9F1239"
      border-radius: 6
    }
  }
  clk_node: {
    style: {
      fill: "#F5F3FF"
      stroke: "#7C3AED"
      stroke-width: 2
      font-color: "#5B21B6"
      border-radius: 6
    }
  }
  sdr_node: {
    style: {
      fill: "#EFF6FF"
      stroke: "#2563EB"
      stroke-width: 2
      font-color: "#1E40AF"
      border-radius: 8
    }
  }
  pwr_node: {
    style: {
      fill: "#FEF2F2"
      stroke: "#EF4444"
      stroke-width: 2
      font-color: "#991B1B"
      border-radius: 6
    }
  }
  buffer_node: {
    shape: queue
    style: {
      fill: "#CCFBF1"
      stroke: "#0D9488"
      stroke-width: 2
      font-color: "#115E59"
    }
  }
  dsp_node: {
    style: {
      fill: "#E0E7FF"
      stroke: "#4338CA"
      stroke-width: 2
      font-color: "#312E81"
      border-radius: 8
    }
  }
  host_node: {
    style: {
      fill: "#D1FAE5"
      stroke: "#059669"
      stroke-width: 2
      font-color: "#064E3B"
      border-radius: 8
    }
  }
}

# ================= TẦNG 1: THU TÍN HIỆU, TIỀN KHUẾCH ĐẠI & BIAS-TEE =================
rf_frontend: "RF Front-End: Antennas, LNAs & Bias-Tee Unit" {
  style: {
    fill: "#F8FAFC"
    stroke: "#CBD5E1"
    stroke-width: 2
    border-radius: 12
  }

  ant1: "Antenna 1\n(Sky Signal)" {class: rf_node}
  fee1: "FEE 1: LNA" {class: rf_node}

  ant2: "Antenna 2\n(Sky Signal)" {class: rf_node}
  fee2: "FEE 2: LNA" {class: rf_node}

  pwr_18v: "External Power Supply\n(18V DC SMPS)" {class: pwr_node}
  bias_tee: "Dual Bias-Tee Unit\n(Integrated 18V-to-15V LDO Regulators)" {class: rf_node}

  ant1 -> fee1
  ant2 -> fee2

  pwr_18v -> bias_tee: "18V DC In" {
    style.stroke: "#EF4444"
    style.stroke-width: 2
  }

  fee1 <-> bias_tee: "15V DC Out + RF In\n(Coax Ch 1)" {
    style.stroke: "#0284C7"
    style.stroke-width: 2
  }
  fee2 <-> bias_tee: "15V DC Out + RF In\n(Coax Ch 2)" {
    style.stroke: "#0284C7"
    style.stroke-width: 2
  }
}

# ================= TẦNG 2: HIỆU CHUẨN TẠP ÂM & KHÓA PHA CLOCK =================
cal_and_clock: "Calibration Source & Reference Clock Generation" {
  style: {
    fill: "#F8FAFC"
    stroke: "#CBD5E1"
    stroke-width: 2
    border-radius: 12
  }

  noise_src: "Avalanche Noise Source" {class: cal_node}

  gpsdo: "GPSDO Clock\n(10 MHz Reference)" {class: clk_node}
  pll_synth: "10-to-24 MHz PLL Multiplier\n(Integrated 1:2 Clock Splitter)" {class: clk_node}

  gpsdo -> pll_synth: "10 MHz Ref" {
    style.stroke: "#7C3AED"
    style.stroke-dash: 3
  }
}

# ================= TẦNG 3: MA TRẬN CHUYỂN MẠCH, BPF & BỘ SỐ HOÁ SDR =================
sdr_stage: "RF Switching, Filtering & Receivers" {
  style: {
    fill: "#F8FAFC"
    stroke: "#CBD5E1"
    stroke-width: 2
    border-radius: 12
  }

  rf_switch: "RF Switch Matrix & Cal Splitter\n(Integrated 1:2 Wye Splitter + Dual HMC544A)" {
    shape: rectangle
    class: rf_node
  }

  bpf1: "BPF 1\n(30.0 – 40.0 MHz)" {class: rf_node}
  bpf2: "BPF 2\n(30.0 – 40.0 MHz)" {class: rf_node}

  rsp1: "RSPdx Channel 1\n(Port C BNC | 10 MSPS)" {class: sdr_node}
  rsp2: "RSPdx Channel 2\n(Port C BNC | 10 MSPS)" {class: sdr_node}

  rf_switch -> bpf1: "Switched Ch 1" {style.stroke: "#2563EB"}
  bpf1 -> rsp1: "Filtered RF 1" {style.stroke: "#2563EB"; style.stroke-width: 2}

  rf_switch -> bpf2: "Switched Ch 2" {style.stroke: "#2563EB"}
  bpf2 -> rsp2: "Filtered RF 2" {style.stroke: "#2563EB"; style.stroke-width: 2}
}

# Định tuyến từ Tầng 1 & Tầng 2 vào Switch và Bộ thu
rf_frontend.bias_tee -> sdr_stage.rf_switch: "Sky Ch 1 (RF Only)" {
  style.stroke: "#0284C7"
  style.stroke-width: 2
}
rf_frontend.bias_tee -> sdr_stage.rf_switch: "Sky Ch 2 (RF Only)" {
  style.stroke: "#0284C7"
  style.stroke-width: 2
}
cal_and_clock.noise_src -> sdr_stage.rf_switch: "Noise In\n(Single 50 Ω Coax)" {style.stroke: "#D97706"}

cal_and_clock.pll_synth -> sdr_stage.rsp1: "REFin 1 (24 MHz)" {
  style.stroke: "#7C3AED"
  style.stroke-dash: 4
}
cal_and_clock.pll_synth -> sdr_stage.rsp2: "REFin 2 (24 MHz)" {
  style.stroke: "#7C3AED"
  style.stroke-dash: 4
}

# ================= TẦNG 4: RASPBERRY PI 5 (EDGE DSP BACKEND) =================
rpi5: "Raspberry Pi 5 (Edge DSP Backend)" {
  style: {
    fill: "#F8FAFC"
    stroke: "#CBD5E1"
    stroke-width: 2
    border-radius: 12
  }

  gpio: "GPIO Controller\n(Logic & Bias Switch)" {
    class: dsp_node
  }

  shm1: "POSIX Shared Memory\nRing Buffer 1 (/dev/shm)" {class: buffer_node}
  shm2: "POSIX Shared Memory\nRing Buffer 2 (/dev/shm)" {class: buffer_node}

  mod2: "Module 2: Time Alignment Engine\n(FFTW3 k=0 Lock / Skip Sample)" {class: dsp_node}
  mod3: "Module 3: FX Correlator Engine\n(Welch 50% Overlap | ARM NEON SIMD)" {class: dsp_node}
  mod4: "Module 4: Telemetry Streamer\n(Non-blocking UDP Socket)" {class: dsp_node}

  shm1 -> mod2: "Stream 1"
  shm2 -> mod2: "Stream 2"
  mod2 -> mod3: "k=0 Aligned"
  mod3 -> mod4: "Integrated Spectrum"
}

# Liên kết USB 3.0 và GPIO
sdr_stage.rsp1 -> rpi5.shm1: "USB 3.0\n40 MB/s" {
  style.stroke: "#2563EB"
  style.stroke-width: 3
}
sdr_stage.rsp2 -> rpi5.shm2: "USB 3.0\n40 MB/s" {
  style.stroke: "#2563EB"
  style.stroke-width: 3
}

rpi5.gpio -> sdr_stage.rf_switch: "Switch Control: Sky / Cal" {
  style.stroke: "#DC2626"
  style.stroke-dash: 3
}
rpi5.gpio -> cal_and_clock.noise_src: "Power Gating Enable" {
  style.stroke: "#DC2626"
  style.stroke-dash: 3
}

# ================= TẦNG 5: HIỂN THỊ TẠI MÁY TRẠM =================
host: "Host PC (Visualization Station)" {
  style: {
    fill: "#F8FAFC"
    stroke: "#CBD5E1"
    stroke-width: 2
    border-radius: 12
  }

  viewer: "PyQtGraph Live Spectrum & Waterfall Viewer\n(Real-time GPU Rendering)" {
    class: host_node
  }
}

rpi5.mod4 -> host.viewer: "Cat6 Direct Stream\nPort 9999 / UDP (~41 KB/s)" {
  style.stroke: "#059669"
  style.stroke-width: 2
  style.stroke-dash: 5
}
